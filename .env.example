# Copy to .env (gitignored) and fill in your cluster's real values.

# Full connection string — used only for discovering things and by
# simulate.js, which lets the driver route writes to whichever node is
# currently primary rather than a fixed one.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/?appName=<app-name>

MONGODB_DB=<database-name>
MONGODB_USER=<db-username>
MONGODB_PASS=<db-password>

# Individual replica set member addresses (host:port), comma-separated.
# The app connects directly to each one rather than through SRV/mongos-style
# routing, so it needs the real member hostnames, not the SRV record.
# If you don't already know them, connect once with MONGODB_URI and run:
#   const { hosts } = await client.db('admin').command({ hello: 1 });
MONGODB_NODE_HOSTS=host-1:27017,host-2:27017,host-3:27017

# Optional. Set only for self-hosted clusters using a private/custom CA
# (e.g. an on-prem replica set) rather than a publicly trusted one like
# Atlas. Path to the CA cert file. Leave unset to use the system default
# trust store.
# MONGODB_TLS_CA_FILE=C:\path\to\ca.crt

PORT=3000
